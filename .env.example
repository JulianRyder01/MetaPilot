# ===== MetaPilot 环境变量模板 =====
# 复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会提交。

# ---- MiniMax AI（判题 / 问答）----
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ---- 本地 Embedding（个人知识库插件）----
# provider: local_transformers | none
EMBEDDING_PROVIDER=local_transformers
EMBEDDING_URL=http://127.0.0.1:8760
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 运行 embedding 服务的 Conda 虚拟环境名
CONDA_ENV=Jyun

# ---- 后端 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 数据目录（相对 backend/ 或绝对路径）
DATA_DIR=./data

# ---- 插件商店（可选）----
# 独立部署的 plugins-store 服务地址（见 plugins-store/README.md）；留空则插件页不显示商店
PLUGIN_STORE_URL=
