# ===== MetaPilot 环境变量模板 =====
# 复制本文件为 .env 并填入真实值；.env 已被 gitignore，不会提交。

# ---- MiniMax AI（判题 / 问答）----
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ---- 本地 Embedding（个人知识库插件）----
# provider: local_transformers | none
EMBEDDING_PROVIDER=local_transformers
EMBEDDING_URL=http://127.0.0.1:8760
# 默认模型：Qwen/Qwen3-Embedding-0.6B（轻量）或 Qwen/Qwen3-Embedding-4B（更强，需更多显存）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 运行 embedding 服务的 Conda 虚拟环境名
CONDA_ENV=Jyun
# 知识库插件首次访问时自动启动本地 embedding 服务（含首次模型多路下载：ModelScope→HF-Mirror→HF）
EMBEDDING_AUTO_START=true

# ---- 后端 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 数据目录（相对 backend/ 或绝对路径）
DATA_DIR=./data

# ---- 插件商店（可选）----
# 独立部署的 plugins-store 服务地址（见 plugins-store/README.md）；留空则插件页不显示商店
PLUGIN_STORE_URL=

# ---- AI 统一网关（核心 1.1.1；所有插件经 MetaPilot 中转调用，密钥/地址不出核心）----
# 云端 chat provider：openai（含 openai 兼容服务）| anthropic | local（内置本地模型）| none（关闭云端 AI）
AI_PROVIDER=openai
# openai 兼容地址（如 OpenAI / MiniMax / DeepSeek 等）/v1；anthropic 填 https://api.anthropic.com
AI_BASE_URL=https://api.minimaxi.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 默认聊天模型
AI_CHAT_MODEL=MiniMax-M3
# 向量（embedding）独立配置：local_transformers（内置下载）| openai（走上方云端地址）| none
AI_EMBEDDING_PROVIDER=local_transformers
AI_EMBEDDING_URL=http://127.0.0.1:8760
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 内置本地模型服务地址（设置页一键下载后自动拉起）
AI_LOCAL_LLM_URL=http://127.0.0.1:8761
AI_RERANK_URL=http://127.0.0.1:8762
# 模型单价（每百万 token）：{"模型": {"input": 输入价, "cachedInput": 缓存命中价, "output": 输出价, "currency": "$|¥"}}
AI_MODEL_PRICES={"MiniMax-M3": {"input": 4, "cachedInput": 0, "output": 12, "currency": "¥"}}
# 默认货币单位：$ 或 ¥
AI_CURRENCY=$
# 内置本地 LLM / 重排模型（设置页一键下载后自动拉起）
AI_LOCAL_LLM_MODEL=Qwen/Qwen3-4B
AI_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
